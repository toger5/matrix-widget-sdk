{
  "name": "matrix-widget-tools-sdk",
  "private": true,
  "workspaces": [
    "packages/widget-host-bindings",
    "packages/*"
  ],
  "scripts": {
    "wasm": "wasm-pack build crates/widget-base-sdk --target web --release",
    "build": "npm run wasm && npm run bindings && npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev": "concurrently -k -n host,widgets -c blue,green \"npm:dev -w packages/widget-host\" \"npm:dev -w packages/test-widgets\"",
    "bindings": "npm run ubrn:web -w packages/widget-host-bindings",
    "build:dev-site": "node scripts/build-dev-site.mjs",
    "pack:npm": "node scripts/pack-npm.mjs",
    "smoke:npm": "node scripts/smoke-npm.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2"
  }
}
