{
  "name": "@matrix-widget-tools/widget-host",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Widget host webapp on matrix-widget-host-driver (uniffi/wasm bindings): logs in with matrix-rust-sdk (or matrix-js-sdk) and opens the widgets of your rooms, or runs on an in-memory room for widget development and e2e testing",
  "scripts": {
    "dev": "vite",
    "dev:js": "vite --mode js",
    "build": "tsc --noEmit && vite build",
    "build:js": "tsc --noEmit && vite build --mode js",
    "preview": "vite preview",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "e2e": "playwright test",
    "stories": "node e2e/tools/stories.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@matrix-widget-sdk/host": "*",
    "matrix-js-sdk": "45.1.0",
    "matrix-sdk-uniffi-js": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storybook/react-vite": "^10.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "storybook": "^10.6.7",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
