{
  "name": "@matrix-widget-tools/widget-host-bindings",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript bindings for the host side (widget-host-driver, widget-matrix-backend, widget-actions), generated from the Rust UniFFI scaffolding with uniffi-bindgen-react-native for the web",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "ubrn:web": "ubrn build web --config ubrn.config.yaml --release",
    "ubrn:web:debug": "ubrn build web --config ubrn.config.yaml",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@ubjs/core": "0.31.0-6"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "uniffi-bindgen-react-native": "0.31.0-6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/element-hq/matrix-widget-tools-sdk",
    "directory": "packages/widget-host-bindings"
  }
}
